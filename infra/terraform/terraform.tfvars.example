# Copie para terraform.tfvars e preencha.
# terraform.tfvars NÃO é versionado.

# Seu IP público — o único que poderá abrir SSH.
# Descubra com: curl -s https://checkip.amazonaws.com
dev_ip = "SEU.IP.AQUI/32"

# Opcionais — os defaults seguem o dimensionamento do infraestrutura-nuvem.md
# region        = "us-east-1"
# instance_type = "t3.medium"

# AWS Academy Learner Lab: a role não pode ser criada, usa-se a do lab.
# Confirme o nome em: console AWS → IAM → Roles → LabRole → "Instance profile ARNs".
# Use "" para subir sem profile (o stack funciona; só o backup p/ S3 fica de fora).
# instance_profile_name = "LabInstanceProfile"
